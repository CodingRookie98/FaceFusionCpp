# npm 12 supply-chain policy for the web frontend.
#
# allow-remote: npm 12 defaults to `none`, which refuses tarballs that are not
#   plain registry-version dependencies. This lockfile resolves part of the tree
#   through explicit URLs (mixed registry hosts, plus
#   @tailwindcss/oxide-wasm32-wasi which npm classifies as a "remote" spec), so
#   `npm install` aborts with EALLOWREMOTE although the registry is reachable.
#   `root` is not sufficient here: the blocked entries are transitive optional
#   dependencies, not project-level ones.
allow-remote=all
#
# allow-scripts: npm 12 also blocks install-time lifecycle scripts by default.
#   esbuild's postinstall generates the binary that vite/vitest execute, so it
#   has to be allowed explicitly (this cannot be passed on the command line for
#   project-scoped installs).
allow-scripts=esbuild
